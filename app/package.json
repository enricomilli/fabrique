{
  "name": "app",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "compose:up": "docker compose -f infra/compose.dev.yaml up",
    "compose:down": "docker compose -f infra/compose.dev.yaml down",
    "generate-routes": "tsr generate",
    "auth:generate": "auth generate --config ./src/integrations/better-auth/index.ts --output ./src/db/schema/auth.ts",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate --config ./src/db/drizzle.config.ts",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate --config ./src/db/drizzle.config.ts",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed-documents.ts",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check --write",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx tests/*.test.mjs",
    "test:i18n": "npm run build && node --test tests/i18n.test.mjs",
    "test:pdf": "npm run build && dotenv -e .env.local -- tsx --test tests/e2e/pdf.test.ts",
    "test:e2e": "npm run build && dotenv -e .env.local -- tsx --test tests/e2e/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/lib-storage": "3.1144.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@posthog/react": "^1.7.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "1.7.7",
    "bullmq": "6.3.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "ioredis": "5.11.1",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "mdast-util-to-string": "^4.0.0",
    "nitro": "3.0.260610-beta",
    "pg": "8.23.1",
    "posthog-js": "^1.358.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@inlang/paraglide-js": "^2.25.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "auth": "1.7.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
