# Server variables from src/env.ts. Do not use a VITE_ prefix.
# Optional server URL. Use this value for local development.
SERVER_URL=http://localhost:3000

# Required local PostgreSQL database from infra/compose.dev.yaml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Required Better Auth secret with at least 32 characters.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required local SeaweedFS storage from infra/compose.dev.yaml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=seaweedadmin
S3_SECRET_ACCESS_KEY=seaweedadmin
S3_BUCKET=app
# Use true or false. Local SeaweedFS uses true.
S3_FORCE_PATH_STYLE=true

# Optional client variable from src/env.ts. The browser can read this value.
VITE_APP_TITLE=

# Optional server variables that src/env.ts does not validate.
# Set this value to a Discord feedback webhook URL.
DISCORD_FEEDBACK_WEBHOOK_URL=

# Optional absolute path to the original PDFs. Default: ../data/pdf from app.
# PDF_DIR=/absolute/path/to/data/pdf

# Required local Redis queue from infra/compose.dev.yaml.
REDIS_URL=redis://localhost:6379
