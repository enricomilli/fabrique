# Public URL behind a TLS reverse proxy.
SERVER_URL=https://fabrique.miri.sh

# Generate each secret separately with: openssl rand -hex 32
# Use a hexadecimal PostgreSQL password to keep the database URL valid.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
S3_ACCESS_KEY_ID=fabrique
S3_SECRET_ACCESS_KEY=

S3_REGION=us-east-1
S3_BUCKET=app

# Only expose the web port to the local reverse proxy by default.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# This worker replays saved content. It does not call a model.
FAKE_GENERATION_DURATION_MS=720000

# Optional Discord feedback webhook.
DISCORD_FEEDBACK_WEBHOOK_URL=
